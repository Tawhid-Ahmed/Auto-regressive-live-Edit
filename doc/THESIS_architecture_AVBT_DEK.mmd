%% AVBT + DEK method architecture (thesis / AAAI Figure)
%% Canonical method row: --patch_grounding --dek_dual_gate
flowchart TB
    subgraph IN["Input edit / query"]
        direction LR
        V["Image v"]
        P["Prompt p"]
        Y["Target y*"]
    end

    subgraph VLM["Frozen BLIP2-OPT-2.7B"]
        direction TB
        BLIP["VLM forward → hidden states h"]
    end

    subgraph KEYS["Expert key construction"]
        direction LR
        QF["Q-Former visual key<br/>evr (scalar routing path)"]
        DINO["DINOv2 patch grid"]
        PGM["PatchGroundingModule"]
        PK["Patch visual key<br/>evr_patch"]
        TK["Prompt / text key<br/>eqr"]
        DINO --> PGM --> PK
    end

    subgraph EDIT["Edit-time expert write"]
        direction TB
        FEG["Expert generator f_eg"]
        EXP["MoE expert e_i"]
        POOL[("Lifelong pool E_t<br/>experts + evr + evr_patch + eqr")]
        FEG --> EXP --> POOL
    end

    subgraph DEK["DEK retrieval — vision ∧ text"]
        direction TB
        VS["Vision gate<br/>sim(v', evr / evr_patch)"]
        TS["Text gate<br/>sim(p', eqr)"]
        AND{"DEK dual-gate<br/>vision_ok ∧ text_ok"}
        VS --> AND
        TS --> AND
        SURV["Surviving experts"]
        AND --> SURV
    end

    subgraph AVBT["AVBT training (adversarial binding)"]
        direction TB
        POS["Positive: bind (p, v_correct) → own expert"]
        NEG["Negative: suppress (p, v_adv) → false-cross"]
        LOSS["L = L_edit + λ L_AVBL"]
        POS --> LOSS
        NEG --> LOSS
    end

    subgraph OUT["Edit injection & output"]
        direction TB
        SOFT["Soft MoE residual ψ"]
        RES["Residual into edit layers"]
        YHAT["Edited answer ŷ"]
        SOFT --> RES --> YHAT
    end

    V --> BLIP
    P --> BLIP
    V --> DINO
    V --> FEG
    P --> FEG
    Y --> FEG
    BLIP --> QF
    BLIP --> TK
    QF --> POOL
    PK --> POOL
    TK --> POOL

    POOL --> VS
    POOL --> TS
    V -.->|"query image v'"| VS
    P -.->|"query prompt p'"| TS

    SURV --> SOFT
    RES -.->|"edit layer"| BLIP
    BLIP --> YHAT

    POOL -.-> AVBT
    LOSS -.->|"train keys + generators"| FEG
    LOSS -.-> PGM

    classDef in fill:#e8f4fc,stroke:#2b6cb0,color:#1a365d
    classDef vlm fill:#ede9fe,stroke:#6d28d9,color:#4c1d95
    classDef key fill:#ffedd5,stroke:#c2410c,color:#7c2d12
    classDef edit fill:#d6ecd2,stroke:#5a8f4e,color:#22543d
    classDef dek fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef avbt fill:#fce7f3,stroke:#be185d,color:#831843
    classDef out fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e

    class V,P,Y in
    class BLIP vlm
    class QF,DINO,PGM,PK,TK key
    class FEG,EXP,POOL edit
    class VS,TS,AND,SURV dek
    class POS,NEG,LOSS avbt
    class SOFT,RES,YHAT out
